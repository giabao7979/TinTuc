<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang chủ - Tin tức mới nhất</title>
    <!-- Bootstrap CSS -->
    <link href="~/Content/css/home-page.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />


</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar danh mục -->
            <div class="col-lg-4 col-md-5">
                <div class="card categories-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-sitemap mr-2"></i>Danh mục tin tức (8 cấp)
                        </h5>
                        <small class="d-block mt-1 opacity-75">
                            <i class="fas fa-info-circle mr-1"></i>Click để xem tin tức,
                            <i class="fas fa-chevron-right mr-1"></i> để mở rộng
                        </small>
                    </div>
                    <div class="card-body p-0">
                        <div id="categories-menu">
                            <div class="loading-spinner">
                                <div class="spinner-border text-primary"></div>
                                <p>Đang tải danh mục...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chú thích danh mục -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-info mr-2"></i>Chú thích 8 cấp</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="small">
                            <div class="d-flex align-items-center mb-1">
                                <div class="bg-primary rounded mr-2" style="width: 12px; height: 3px;"></div>
                                <span>Cấp 0: Danh mục gốc</span>
                            </div>
                            <div class="d-flex align-items-center mb-1">
                                <div class="bg-success rounded mr-2" style="width: 12px; height: 3px;"></div>
                                <span>Cấp 1: Danh mục con</span>
                            </div>
                            <div class="d-flex align-items-center mb-1">
                                <div class="bg-warning rounded mr-2" style="width: 12px; height: 3px;"></div>
                                <span>Cấp 2: Danh mục con</span>
                            </div>
                            <div class="d-flex align-items-center mb-1">
                                <div class="bg-info rounded mr-2" style="width: 12px; height: 3px;"></div>
                                <span>Cấp 3: Danh mục con</span>
                            </div>
                            <div class="d-flex align-items-center mb-1">
                                <div class="bg-dark rounded mr-2" style="width: 12px; height: 3px;"></div>
                                <span>Cấp 4-7: Danh mục sâu</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick navigation -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-fast-forward mr-2"></i>Chuyển nhanh</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="btn-group-vertical btn-group-sm w-100" role="group">
                            <button type="button" class="btn btn-outline-primary mb-1" onclick="loadCategoryNews(1)">
                                <i class="fas fa-folder mr-1"></i>Danh mục 1
                            </button>
                            <button type="button" class="btn btn-outline-success mb-1" onclick="loadCategoryNews(2)">
                                <i class="fas fa-folder mr-1"></i>Danh mục 2
                            </button>
                            <button type="button" class="btn btn-outline-warning mb-1" onclick="loadCategoryNews(3)">
                                <i class="fas fa-folder mr-1"></i>Danh mục 3
                            </button>
                            <button type="button" class="btn btn-outline-info" onclick="loadCategoryNews(4)">
                                <i class="fas fa-folder mr-1"></i>Danh mục 4
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main content -->
            <div class="col-lg-8 col-md-7">
                <!-- Search -->
                <!-- CẬP NHẬT PHẦN SEARCH TRONG Views/Home/Index.cshtml -->

                <div class="card search-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-search mr-2"></i>Tìm kiếm tin tức
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="input-group search-input-group">
                            <input type="text" id="search-input" class="form-control"
                                   placeholder="Nhập từ khóa tìm kiếm (tối thiểu 3 ký tự)...">
                            <div class="input-group-append">
                                <button type="button" onclick="performSearch()" class="btn btn-primary">
                                    <i class="fa fa-search mr-1"></i>Tìm kiếm
                                </button>
                                <button type="button" onclick="clearSearch()" class="btn btn-secondary">
                                    <i class="fa fa-times mr-1"></i>Xóa
                                </button>
                            </div>
                            <!-- Quick search results container -->
                            <div id="quickSearchResults" style="display: none;"></div>
                        </div>

                        <!-- Updated search hints -->
                        <div class="search-hints">
                            <div class="hint-item">
                                <i class="fas fa-info-circle"></i>
                                Nhập ít nhất 3 ký tự và dừng để tìm kiếm tự động
                            </div>
                            <div class="hint-item">
                                <i class="fas fa-keyboard"></i>
                                Hoặc nhấn Enter để tìm ngay
                            </div>
                            <div class="hint-item">
                                <i class="fas fa-clock"></i>
                                Hệ thống sẽ chờ 1.2 giây sau khi bạn dừng nhập
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CẬP NHẬT SCRIPT TRONG CÙNG FILE -->
                <script>
                    // Cập nhật hàm performSearch với thông báo mới
                    function performSearch() {
                        var query = $('#search-input').val().trim();
                        if (query.length < 3) {
                            // Hiển thị thông báo thân thiện hơn
                            showNotification('Vui lòng nhập ít nhất 3 ký tự để có kết quả tìm kiếm tốt hơn 😊', 'info');
                            $('#search-input').focus();
                            return;
                        }

                        // Hiển thị trạng thái đang tìm
                        showSearchIndicator(true);

                        updateHeader('🔍 Đang tìm kiếm: "' + query + '"');
                        showLoadingInContent();

                        $.ajax({
                            url: '/Home/QuickSearch',
                            type: 'GET',
                            data: { term: query, maxResults: 20 },
                            dataType: 'json',
                            timeout: 10000, // 10 giây timeout
                            success: function (data) {
                                showSearchIndicator(false);
                                if (data.success && data.results && data.results.length > 0) {
                                    displaySearchResults(data.results, query);
                                    showNotification('Tìm thấy ' + data.results.length + ' kết quả!', 'success');
                                } else {
                                    showNoSearchResults(query);
                                    showNotification('Không tìm thấy kết quả cho "' + query + '"', 'warning');
                                }
                            },
                            error: function (xhr, status, error) {
                                showSearchIndicator(false);
                                console.error('Search error:', error);
                                showSearchError();

                                if (status === 'timeout') {
                                    showNotification('Tìm kiếm quá lâu, vui lòng thử lại', 'error');
                                } else {
                                    showNotification('Có lỗi xảy ra khi tìm kiếm', 'error');
                                }
                            }
                        });
                    }

                    // Hàm hiển thị thông báo đẹp
                    function showNotification(message, type = 'info') {
                        // Remove existing notifications
                        $('.search-notification').remove();

                        var iconClass, bgClass;
                        switch (type) {
                            case 'success': iconClass = 'fa-check-circle'; bgClass = 'alert-success'; break;
                            case 'warning': iconClass = 'fa-exclamation-triangle'; bgClass = 'alert-warning'; break;
                            case 'error': iconClass = 'fa-times-circle'; bgClass = 'alert-danger'; break;
                            default: iconClass = 'fa-info-circle'; bgClass = 'alert-info';
                        }

                        var notification = $('<div class="alert ' + bgClass + ' alert-dismissible fade show search-notification" style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">' +
                            '<i class="fas ' + iconClass + ' mr-2"></i>' + message +
                            '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                            '</div>');

                        $('body').append(notification);

                        // Auto hide after 4 seconds
                        setTimeout(function () {
                            notification.fadeOut(function () { $(this).remove(); });
                        }, 4000);
                    }

                    // Cập nhật setupSearch với thời gian chờ mới
                    function setupSearch() {
                        $('#search-input').off('keyup').on('keyup', function (e) {
                            try {
                                if (e.key === 'Enter') {
                                    performSearch();
                                    return;
                                }

                                clearTimeout(searchTimeout);
                                var query = $(this).val().trim();
                                if (query.length === 0) {
                                    clearSearch();
                                    return;
                                }

                                // Hiển thị hint khi đang nhập
                                if (query.length > 0 && query.length < 10) {
                                    $('.search-hints').html(
                                        '<div class="hint-item text-muted">' +
                                        '<i class="fas fa-edit"></i>' +
                                        'Còn ' + (10 - query.length) + ' ký tự nữa để bắt đầu tìm kiếm...' +
                                        '</div>'
                                    );
                                } else if (query.length >= 3) {
                                    $('.search-hints').html(
                                        '<div class="hint-item text-primary">' +
                                        '<i class="fas fa-hourglass-half"></i>' +
                                        'Sẽ tìm kiếm sau 1.2 giây nếu bạn dừng nhập...' +
                                        '</div>'
                                    );
                                }

                                // Chỉ tìm khi dừng nhập và đủ ký tự
                                searchTimeout = setTimeout(function () {
                                    if (query.length >= 3) {
                                        // Reset hints
                                        $('.search-hints').html(
                                            '<div class="hint-item"><i class="fas fa-info-circle"></i>Nhập ít nhất 3 ký tự và dừng để tìm kiếm tự động</div>' +
                                            '<div class="hint-item"><i class="fas fa-keyboard"></i>Hoặc nhấn Enter để tìm ngay</div>' +
                                            '<div class="hint-item"><i class="fas fa-clock"></i>Hệ thống sẽ chờ 1.2 giây sau khi bạn dừng nhập</div>'
                                        );
                                        performSearch();
                                    }
                                }, 2000); // 1.2 giây

                            } catch (error) {
                                console.error('Search error:', error);
                            }
                        });

                        // Focus event
                        $('#search-input').focus(function () {
                            $(this).parent().addClass('shadow-sm');
                        }).blur(function () {
                            $(this).parent().removeClass('shadow-sm');
                        });
                    }

                    console.log('✅ Enhanced search system loaded - Wait 1.2s after stop typing');
                </script>

                <!-- Content display -->
                <div class="card content-card">
                    <div class="card-header" id="content-header">
                        <h3 class="mb-0" id="content-title">
                            <i class="fas fa-newspaper mr-2"></i>Tin tức ở danh mục 1
                        </h3>
                    </div>
                    <div class="card-body">
                        <div id="content-container" class="content-container">
                            <div class="loading-spinner">
                                <div class="spinner-border text-primary"></div>
                                <p>Đang tải tin tức từ danh mục 1...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>

    <script>
        // ===== GLOBAL VARIABLES =====
        var currentMode = 'category';
        var currentCategoryId = 1;
        var currentCategoryName = '';
        var searchTimeout;

        // ===== INITIALIZATION =====
        $(document).ready(function () {
            console.log('✅ DOM ready, jQuery:', $.fn.jquery);

            setTimeout(function () {
                initializeHomePage();
            }, 300);
        });

        function initializeHomePage() {
            console.log('🚀 Initializing optimized home page...');

            if (!$('#content-container').length || !$('#categories-menu').length) {
                console.error('❌ Required elements not found');
                return;
            }

            loadCategories();
            setTimeout(() => loadCategoryNews(1), 1000);
            setupSearch();
        }

        function setupSearch() {
            $('#search-input').off('keyup').on('keyup', function (e) {
                try {
                    if (e.key === 'Enter') {
                        performSearch();
                        return;
                    }

                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function () {
                        var query = $('#search-input').val().trim();
                        if (query.length >= 2) {
                            performSearch();
                        } else if (query.length === 0) {
                            clearSearch();
                        }
                    }, 500);
                } catch (error) {
                    console.error('Search error:', error);
                }
            });
        }

        // ===== CATEGORY LOADING =====
        function loadCategories() {
            console.log('📂 Loading categories...');

            $.ajax({
                url: '/Home/GetCategoriesTree',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    console.log('Categories response:', data);
                    if (data.success && data.categories) {
                        displayCategories(data.categories);
                    } else {
                        showErrorCategories();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading categories:', error);
                    showErrorCategories();
                }
            });
        }

        function displayCategories(categories) {
            if (!Array.isArray(categories)) {
                console.error('Invalid categories data');
                return;
            }

            var html = '<div class="categories-menu">';

            for (var i = 0; i < Math.min(categories.length, 100); i++) {
                var cat = categories[i];
                if (!cat.Id || !cat.Name) continue;

                html += '<div class="category-item" data-category-level="0">';
                html += '<div class="category-link" data-category-id="' + cat.Id + '" data-category-name="' + escapeHtml(cat.Name) + '" data-level="0">';
                html += '<div class="category-content">';
                html += '<div class="category-name font-weight-bold">' + escapeHtml(cat.Name) + '</div>';
                html += '<div class="category-meta">';
                html += '<span class="news-count">' + (cat.NewsCount || 0) + '</span>';

                if (cat.HasChildren) {
                    html += '<button class="category-toggle-btn toggle-btn" ';
                    html += 'data-parent-id="' + cat.Id + '" data-level="0" type="button">';
                    html += '<i class="fas fa-chevron-right"></i>';
                    html += '</button>';
                }

                html += '</div></div></div>';

                if (cat.HasChildren) {
                    html += '<div id="subcategories-' + cat.Id + '" class="subcategories-container"></div>';
                }

                html += '</div>';
            }

            html += '</div>';

            $('#categories-menu').html(html);
            attachCategoryEventListeners();

            setTimeout(() => setActiveCategory(1), 500);
        }

        function attachCategoryEventListeners() {
            console.log('📎 Attaching category event listeners...');

            // Category click events for all 8 levels
            $('.category-link, .subcategory-link, .sub-subcategory-link, .level-4-link, .level-5-link, .level-6-link, .level-7-link, .level-8-link').off('click').on('click', function (e) {
                if ($(e.target).closest('.toggle-btn').length) {
                    return;
                }

                var categoryId = $(this).data('category-id');
                var categoryName = $(this).data('category-name');
                console.log('Category clicked:', categoryId, categoryName);

                if (categoryId) {
                    loadCategoryNews(categoryId);
                }
            });

            // Toggle button events
            $('.toggle-btn').off('click').on('click', function (e) {
                e.stopPropagation();
                var parentId = $(this).data('parent-id');
                var level = $(this).data('level') || 0;
                console.log('Toggle clicked:', parentId, level);

                if (parentId) {
                    toggleCategory(parentId, level);
                }
            });
        }

        // ===== NEWS LOADING =====
        function loadCategoryNews(categoryId) {
            console.log('📰 Loading news for category:', categoryId);

            if (!categoryId) return;

            currentCategoryId = categoryId;
            currentCategoryName = findCategoryNameById(categoryId) || ('Danh mục ' + categoryId);

            setActiveCategory(categoryId);
            updateHeader('Tin tức ở danh mục: ' + currentCategoryName);
            showLoadingInContent();

            $.ajax({
                url: '/Home/GetNewsByCategory',
                type: 'GET',
                data: { categoryId: categoryId, page: 1, pageSize: 20 },
                dataType: 'json',
                success: function (data) {
                    console.log('News response:', data);

                    if (data.success && data.data && data.data.length > 0) {
                        displayNews(data.data, data.totalCount);
                    } else {
                        showNoNews();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading news:', error);
                    showNewsError();
                }
            });
        }

        function displayNews(newsArray, totalCount) {
            var html = '<div class="alert alert-info mb-4">';
            html += '<i class="fas fa-info-circle mr-2"></i>';
            html += 'Tìm thấy ' + totalCount + ' tin tức trong danh mục "' + escapeHtml(currentCategoryName) + '"';
            html += '</div>';

            html += '<div class="row">';

            for (var i = 0; i < newsArray.length; i++) {
                var news = newsArray[i];
                html += '<div class="col-md-6 col-lg-4 mb-4">';
                html += '<div class="card news-card h-100">';
                html += '<div class="card-body d-flex flex-column">';
                html += '<h5 class="news-title">';
                html += '<a href="/News/Details/' + news.Id + '">' + escapeHtml(news.Title) + '</a>';
                html += '</h5>';

                if (news.Summary) {
                    html += '<p class="news-summary flex-grow-1">' + escapeHtml(news.Summary) + '</p>';
                }

                html += '<div class="mt-auto pt-2 border-top">';
                html += '<small class="text-muted">';
                html += '<i class="far fa-calendar-alt mr-1"></i>' + escapeHtml(news.CreatedDate);
                html += '</small>';
                html += '</div>';
                html += '</div></div></div>';
            }

            html += '</div>';

            // Navigation
            html += '<div class="text-center mt-4">';
            html += '<div class="btn-group" role="group">';
            html += '<button class="btn btn-outline-primary" onclick="loadCategoryNews(' + currentCategoryId + ')">';
            html += '<i class="fas fa-redo mr-1"></i>Tải lại';
            html += '</button>';
            if (currentCategoryId > 1) {
                html += '<button class="btn btn-outline-secondary" onclick="loadCategoryNews(' + (currentCategoryId - 1) + ')">';
                html += '<i class="fas fa-chevron-left mr-1"></i>Trước';
                html += '</button>';
            }
            html += '<button class="btn btn-outline-secondary" onclick="loadCategoryNews(' + (currentCategoryId + 1) + ')">';
            html += 'Sau<i class="fas fa-chevron-right ml-1"></i>';
            html += '</button>';
            html += '</div>';
            html += '</div>';

            $('#content-container').html(html);
        }

        // ===== SEARCH FUNCTIONS =====
        function performSearch() {
            var query = $('#search-input').val().trim();
            if (query.length < 2) {
                alert('Vui lòng nhập ít nhất 2 ký tự');
                return;
            }

            updateHeader('Tìm kiếm: "' + query + '"');
            showLoadingInContent();

            $.ajax({
                url: '/Home/QuickSearch',
                type: 'GET',
                data: { term: query, maxResults: 20 },
                dataType: 'json',
                success: function (data) {
                    if (data.success && data.results && data.results.length > 0) {
                        displaySearchResults(data.results, query);
                    } else {
                        showNoSearchResults(query);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Search error:', error);
                    showSearchError();
                }
            });
        }

        function displaySearchResults(results, query) {
            var html = '<div class="alert alert-success mb-4">';
            html += '<i class="fas fa-search mr-2"></i>';
            html += 'Tìm thấy ' + results.length + ' kết quả cho: "' + escapeHtml(query) + '"';
            html += '</div>';

            html += '<div class="row">';

            for (var i = 0; i < results.length; i++) {
                var news = results[i];
                html += '<div class="col-md-6 col-lg-4 mb-4">';
                html += '<div class="card news-card h-100">';
                html += '<div class="card-body">';
                html += '<h5 class="news-title">';
                html += '<a href="/News/Details/' + news.Id + '">' + escapeHtml(news.Title) + '</a>';
                html += '</h5>';

                if (news.Summary) {
                    html += '<p class="news-summary">' + escapeHtml(news.Summary) + '</p>';
                }

                html += '<small class="text-muted">';
                html += '<i class="far fa-calendar-alt mr-1"></i>' + escapeHtml(news.CreatedDate);
                html += '</small>';
                html += '</div></div></div>';
            }

            html += '</div>';

            html += '<div class="text-center mt-4">';
            html += '<button class="btn btn-secondary" onclick="clearSearch()">';
            html += '<i class="fas fa-arrow-left mr-1"></i>Quay lại danh mục hiện tại';
            html += '</button>';
            html += '</div>';

            $('#content-container').html(html);
        }

        function clearSearch() {
            $('#search-input').val('');
            loadCategoryNews(currentCategoryId || 1);
        }

        // ===== TOGGLE FUNCTIONS (SUPPORT 8 LEVELS) =====
        function toggleCategory(categoryId, level) {
            console.log('🔄 toggleCategory:', categoryId, level);

            var container = $('#subcategories-' + categoryId);
            var toggleBtn = $('[data-parent-id="' + categoryId + '"]');

            if (container.hasClass('expanded')) {
                container.removeClass('expanded').slideUp(300);
                toggleBtn.removeClass('expanded').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-right');
            } else {
                container.html('<div class="text-center p-2"><small class="text-muted"><i class="fa fa-spinner fa-spin"></i> Đang tải...</small></div>');
                container.addClass('expanded').slideDown(300);
                toggleBtn.addClass('expanded').find('i').removeClass('fa-chevron-right').addClass('fa-chevron-down');

                loadSubcategories(categoryId, level + 1);
            }
        }

        function loadSubcategories(parentId, level) {
            console.log('📂 loadSubcategories:', parentId, level);

            // Limit depth to 8 levels (0-7)
            if (level > 7) {
                $('#subcategories-' + parentId).html('<div class="text-center p-2"><small class="text-muted">Đã đạt cấp tối đa</small></div>');
                return;
            }

            $.ajax({
                url: '/Home/GetSubcategories',
                type: 'GET',
                data: { parentId: parentId },
                dataType: 'json',
                success: function (data) {
                    console.log('Subcategories loaded:', data);

                    if (data.success && data.subcategories && data.subcategories.length > 0) {
                        displaySubcategories(parentId, data.subcategories, level);
                    } else {
                        $('#subcategories-' + parentId).html('<div class="text-center p-2"><small class="text-muted">Không có danh mục con</small></div>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading subcategories:', error);
                    var container = $('#subcategories-' + parentId);
                    container.html(
                        '<div class="text-center p-2">' +
                        '<small class="text-danger"><i class="fas fa-exclamation-triangle mr-1"></i>Lỗi tải danh mục</small><br>' +
                        '<button onclick="loadSubcategories(' + parentId + ', ' + level + ')" class="btn btn-sm btn-outline-danger mt-1">' +
                        '<i class="fas fa-redo mr-1"></i>Thử lại</button>' +
                        '</div>'
                    );
                }
            });
        }

        function displaySubcategories(parentId, subcategories, level) {
            var container = $('#subcategories-' + parentId);
            var html = '';

            for (var i = 0; i < subcategories.length; i++) {
                var sub = subcategories[i];
                if (!sub.Id || !sub.Name) continue;

                var linkClass = getCategoryLinkClass(level);

                html += '<div class="category-item" data-category-level="' + level + '">';
                html += '<div class="' + linkClass + '" data-category-id="' + sub.Id + '" data-category-name="' + escapeHtml(sub.Name) + '" data-level="' + level + '">';
                html += '<div class="category-content">';
                html += '<div class="category-name">' + escapeHtml(sub.Name) + '</div>';
                html += '<div class="category-meta">';
                html += '<span class="news-count">' + (sub.NewsCount || 0) + '</span>';

                // Toggle button if has children and not at max depth
                if (sub.HasChildren && level < 7) {
                    html += '<button class="category-toggle-btn toggle-btn" ';
                    html += 'data-parent-id="' + sub.Id + '" data-level="' + level + '" type="button">';
                    html += '<i class="fas fa-chevron-right"></i>';
                    html += '</button>';
                }

                html += '</div></div></div>';

                // Container for next level
                if (sub.HasChildren && level < 7) {
                    html += '<div id="subcategories-' + sub.Id + '" class="subcategories-container"></div>';
                }

                html += '</div>';
            }

            container.html(html);
            attachSubcategoryEventListeners(container);
        }

        function attachSubcategoryEventListeners(container) {
            // Click events for all levels
            container.find('.subcategory-link, .sub-subcategory-link, .level-4-link, .level-5-link, .level-6-link, .level-7-link, .level-8-link').off('click').on('click', function (e) {
                if ($(e.target).closest('.toggle-btn').length) {
                    return;
                }

                var categoryId = $(this).data('category-id');
                if (categoryId) {
                    loadCategoryNews(categoryId);
                }
            });

            // Toggle events
            container.find('.toggle-btn').off('click').on('click', function (e) {
                e.stopPropagation();
                var parentId = $(this).data('parent-id');
                var level = $(this).data('level');

                if (parentId) {
                    toggleCategory(parentId, level);
                }
            });
        }

        function getCategoryLinkClass(level) {
            switch (level) {
                case 1: return 'subcategory-link';
                case 2: return 'sub-subcategory-link';
                case 3: return 'level-4-link';
                case 4: return 'level-5-link';
                case 5: return 'level-6-link';
                case 6: return 'level-7-link';
                case 7: return 'level-8-link';
                default: return 'level-8-link';
            }
        }

        // ===== HELPER FUNCTIONS =====
        function setActiveCategory(categoryId) {
            $('.category-link, .subcategory-link, .sub-subcategory-link, .level-4-link, .level-5-link, .level-6-link, .level-7-link, .level-8-link').removeClass('active');
            $('[data-category-id="' + categoryId + '"]').addClass('active');

            // Scroll to active category
            var $activeCategory = $('[data-category-id="' + categoryId + '"]');
            var $categoryMenu = $('#categories-menu');

            if ($activeCategory.length && $categoryMenu.length) {
                var categoryTop = $activeCategory.position().top;
                var menuHeight = $categoryMenu.height();
                var menuScrollTop = $categoryMenu.scrollTop();

                if (categoryTop < 0 || categoryTop > menuHeight) {
                    $categoryMenu.animate({
                        scrollTop: menuScrollTop + categoryTop - menuHeight / 2
                    }, 300);
                }
            }
        }

        function findCategoryNameById(categoryId) {
            var name = '';
            $('[data-category-id="' + categoryId + '"]').each(function () {
                name = $(this).data('category-name');
                return false;
            });
            return name;
        }

        function updateHeader(title) {
            $('#content-title').html('<i class="fas fa-newspaper mr-2"></i>' + title);
        }

        function showLoadingInContent() {
            $('#content-container').html(
                '<div class="loading-spinner">' +
                '<div class="spinner-border text-primary"></div>' +
                '<p>Đang tải...</p>' +
                '</div>'
            );
        }

        function showNoNews() {
            $('#content-container').html(
                '<div class="alert alert-warning text-center">' +
                '<h4><i class="fas fa-folder-open mr-2"></i>Không có tin tức</h4>' +
                '<p>Danh mục "' + escapeHtml(currentCategoryName) + '" chưa có tin tức nào.</p>' +
                '<a href="/News/Create" class="btn btn-primary mt-2">' +
                '<i class="fas fa-plus mr-1"></i>Thêm tin tức mới</a>' +
                '</div>'
            );
        }

        function showNewsError() {
            $('#content-container').html(
                '<div class="alert alert-danger text-center">' +
                '<h4><i class="fas fa-exclamation-triangle mr-2"></i>Lỗi</h4>' +
                '<p>Không thể tải tin tức. Vui lòng thử lại.</p>' +
                '<button class="btn btn-primary" onclick="loadCategoryNews(' + currentCategoryId + ')">Thử lại</button>' +
                '</div>'
            );
        }

        function showNoSearchResults(query) {
            $('#content-container').html(
                '<div class="alert alert-warning text-center">' +
                '<h4><i class="fas fa-search mr-2"></i>Không tìm thấy</h4>' +
                '<p>Không có kết quả cho: "' + escapeHtml(query) + '"</p>' +
                '<button class="btn btn-primary" onclick="clearSearch()">Quay lại danh mục hiện tại</button>' +
                '</div>'
            );
        }

        function showSearchError() {
            $('#content-container').html(
                '<div class="alert alert-danger text-center">' +
                '<h4><i class="fas fa-exclamation-triangle mr-2"></i>Lỗi tìm kiếm</h4>' +
                '<p>Có lỗi xảy ra khi tìm kiếm.</p>' +
                '<button class="btn btn-primary" onclick="clearSearch()">Quay lại danh mục hiện tại</button>' +
                '</div>'
            );
        }

        function showErrorCategories() {
            $('#categories-menu').html(
                '<div class="text-center p-3">' +
                '<p class="text-muted">Không thể tải danh mục</p>' +
                '<button class="btn btn-sm btn-secondary" onclick="loadCategories()">Thử lại</button>' +
                '</div>'
            );
        }

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        console.log('✅ Optimized 8-level category system loaded');
    </script>

</body>
</html>