@model NewsManagement.Models.Category
@{
    ViewBag.Title = "Sửa danh mục";
}

<!-- CSS - GIỮ NGUYÊN -->
<link href="~/Content/css/site.css" rel="stylesheet" />
<link href="~/Content/css/home-page.css" rel="stylesheet" />
<link href="~/Content/css/creat.css" rel="stylesheet" />
<link href="~/Content/css/category.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-edit mr-2"></i>Chỉnh sửa danh mục</h3>
                    <small class="d-block mt-1 text-muted">Cập nhật thông tin danh mục - Tối ưu cho 1M+ danh mục</small>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Edit", "Category", FormMethod.Post, new { @class = "form-horizontal" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Id)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <!-- Thông tin hiện tại -->
                        <div class="alert alert-info">
                            <strong><i class="fas fa-info-circle mr-1"></i>Thông tin hiện tại:</strong>
                            ID: #@Model.Id |
                            Thứ tự: @Model.Ordering |
                            Trạng thái: @(Model.Status ? "Hoạt động" : "Tạm dừng")
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, "Tên danh mục", htmlAttributes: new { @class = "control-label font-weight-bold" })
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Nhập tên danh mục..." } })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">Tên danh mục phải rõ ràng và dễ hiểu</small>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Description, "Mô tả", htmlAttributes: new { @class = "control-label font-weight-bold" })
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 4, placeholder = "Mô tả chi tiết về danh mục này..." })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">Mô tả ngắn gọn về nội dung của danh mục</small>
                        </div>

                        <!-- OPTIMIZED CATEGORY TREE SELECTOR -->
                        <div class="form-group">
                            <label class="control-label font-weight-bold">
                                <i class="fas fa-sitemap mr-2"></i>Danh mục cha
                                <span class="badge badge-success ml-2">✅ Tối ưu</span>
                            </label>

                            <!-- Selected Category Display -->
                            <div class="selected-category-display mb-3">
                                <div class="card border-primary">
                                    <div class="card-body py-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>Danh mục được chọn:</strong>
                                                <span id="selectedCategoryName" class="text-primary ml-2">
                                                    @if (Model.ParentId.HasValue)
                                                    {
                                                        <i class="fas fa-folder mr-1"></i><span>Đang tải thông tin danh mục cha...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-home mr-1"></i><span>Danh mục gốc (không có danh mục cha)</span>
                                                    }
                                                </span>
                                            </div>
                                            <button type="button" id="clearSelection" class="btn btn-sm btn-outline-secondary" style="@(Model.ParentId.HasValue ? "" : "display: none;")">
                                                <i class="fas fa-times mr-1"></i>Bỏ chọn
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Search and Toggle -->
                            <div class="category-selector-controls mb-3">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <button type="button" id="toggleCategoryTree" class="btn btn-outline-primary">
                                            <i class="fas fa-chevron-down" id="toggleIcon"></i>
                                            <span id="toggleText">Hiển thị danh mục</span>
                                        </button>
                                    </div>
                                    <input type="text" id="categorySearch" class="form-control"
                                           placeholder="Tìm kiếm danh mục..." autocomplete="off" disabled>
                                    <div class="input-group-append">
                                        <button type="button" id="clearSearch" class="btn btn-outline-secondary">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <small class="form-text text-muted">
                                    <i class="fas fa-info-circle mr-1"></i>
                                    <span class="text-success">✅ Tối ưu:</span> Chỉ load 50 danh mục/lần • Search nhanh • Pagination tự động •
                                    Không thể chọn chính danh mục này hoặc danh mục con của nó.
                                </small>
                            </div>

                            <!-- Category Tree Container -->
                            <div id="categoryTreeContainer" class="category-tree-container" style="display: none;">
                                <div class="card">
                                    <div class="card-header py-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0">
                                                <i class="fas fa-folder mr-2"></i>Chọn danh mục cha
                                                <span class="badge badge-info ml-2" id="categoryCount">Đang tải...</span>
                                            </h6>
                                            <small class="text-muted">
                                                <span id="performanceIndicator">Performance: OK</span>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="card-body p-0">
                                        <div id="categoryTree" class="category-tree-content">
                                            <div class="loading-spinner text-center py-4">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="sr-only">Loading...</span>
                                                </div>
                                                <p class="mt-2 mb-0">Đang tải danh mục...</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Hidden Input for Selected Parent ID -->
                            <input type="hidden" id="selectedParentId" name="ParentId" value="@Model.ParentId" />
                            @Html.ValidationMessageFor(model => model.ParentId, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Ordering, "Thứ tự", htmlAttributes: new { @class = "control-label font-weight-bold" })
                            @Html.EditorFor(model => model.Ordering, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                            @Html.ValidationMessageFor(model => model.Ordering, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">Số thứ tự để sắp xếp danh mục (số nhỏ hơn sẽ hiển thị trước)</small>
                        </div>

                        <div class="form-group">
                            <div class="form-check">
                                @Html.CheckBoxFor(model => model.Status, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.Status, "Hoạt động", htmlAttributes: new { @class = "form-check-label font-weight-bold" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="btn-group" role="group">
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="fas fa-save mr-2"></i>Cập nhật danh mục
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-times mr-2"></i>Hủy
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>

class OptimizedEditCategorySelector {
    constructor(editingCategoryId, initialParentId = null) {
        this.editingCategoryId = editingCategoryId;
        this.selectedParentId = initialParentId;

        // API endpoints
        this.apiUrl = '/Category/GetAvailableCategoriesForEdit';
        this.validateUrl = '/Category/ValidateCategorySelection';
        this.nameUrl = '/Category/GetCategoryName';

        // State
        this.categories = [];
        this.currentPage = 1;
        this.pageSize = 50;
        this.searchTerm = '';
        this.isLoading = false;
        this.hasMore = false;
        this.totalCount = 0;

        // Cache
        this.cache = new Map();
        this.searchTimeout = null;

        // Performance monitoring
        this.performanceStats = {
            loadTime: 0,
            renderTime: 0,
            searchTime: 0
        };

        this.init();
    }

    init() {
        console.log('🚀 Initializing OptimizedEditCategorySelector for category:', this.editingCategoryId);
        this.bindEvents();
        this.loadInitialParentName();
    }

    bindEvents() {
        // Toggle tree visibility
        $('#toggleCategoryTree').on('click', () => {
            this.toggleCategoryTree();
        });

        // Clear selection
        $('#clearSelection').on('click', () => {
            this.clearSelection();
        });

        // Search with debouncing
        $('#categorySearch').on('input', (e) => {
            const value = e.target.value.trim();
            this.handleSearch(value);
        });

        // Clear search
        $('#clearSearch').on('click', () => {
            this.clearSearch();
        });

        // Infinite scroll
        $('#categoryTree').on('scroll', () => {
            this.handleScroll();
        });

        // Form validation
        $('form').on('submit', (e) => {
            if (!this.validateSelection()) {
                e.preventDefault();
                return false;
            }
            console.log('✅ Form submitting with ParentId:', this.selectedParentId);
        });
    }

    async loadInitialParentName() {
        if (!this.selectedParentId) return;

        try {
            const response = await fetch(`${this.nameUrl}?id=${this.selectedParentId}`);
            const data = await response.json();

            if (data.success) {
                this.updateSelectedDisplay(data.name);
                console.log('✅ Loaded initial parent name:', data.name);
            }
        } catch (error) {
            console.warn('Could not load initial parent name:', error);
        }
    }

    toggleCategoryTree() {
        const container = $('#categoryTreeContainer');
        const isVisible = container.is(':visible');

        if (isVisible) {
            this.hideTree();
        } else {
            this.showTree();
        }
    }

    showTree() {
        $('#categoryTreeContainer').slideDown(300);
        $('#toggleIcon').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        $('#toggleText').text('Ẩn danh mục');
        $('#categorySearch').prop('disabled', false);

        // Load initial data
        if (this.categories.length === 0 && !this.searchTerm) {
            this.loadCategories();
        }
    }

    hideTree() {
        $('#categoryTreeContainer').slideUp(300);
        $('#toggleIcon').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        $('#toggleText').text('Hiển thị danh mục');
        $('#categorySearch').prop('disabled', true);
    }

    handleSearch(value) {
        this.searchTerm = value;

        clearTimeout(this.searchTimeout);

        // Debounced search
        this.searchTimeout = setTimeout(() => {
            this.resetAndLoad();
        }, 300);
    }

    clearSearch() {
        $('#categorySearch').val('');
        this.searchTerm = '';
        this.resetAndLoad();
    }

    resetAndLoad() {
        this.currentPage = 1;
        this.categories = [];
        this.hasMore = false;
        this.loadCategories();
    }

    async loadCategories(append = false) {
        if (this.isLoading) return;

        const startTime = performance.now();

        // Check cache
        const cacheKey = `${this.searchTerm}:${this.currentPage}`;
        if (this.cache.has(cacheKey)) {
            this.handleLoadSuccess(this.cache.get(cacheKey), append);
            return;
        }

        this.isLoading = true;
        this.showLoading(append);

        try {
            const params = new URLSearchParams({
                editingCategoryId: this.editingCategoryId,
                searchTerm: this.searchTerm,
                page: this.currentPage,
                pageSize: this.pageSize
            });

            const response = await fetch(`${this.apiUrl}?${params}`);
            const data = await response.json();

            if (data.success) {
                // Cache result
                this.cache.set(cacheKey, data);

                // Limit cache size
                if (this.cache.size > 50) {
                    const firstKey = this.cache.keys().next().value;
                    this.cache.delete(firstKey);
                }

                this.handleLoadSuccess(data, append);

                // Update performance stats
                this.performanceStats.loadTime = Math.round(performance.now() - startTime);
                this.updatePerformanceIndicator();

            } else {
                this.showError(data.message || 'Lỗi load danh mục');
            }
        } catch (error) {
            console.error('❌ Error loading categories:', error);
            this.showError('Lỗi kết nối server');
        } finally {
            this.isLoading = false;
        }
    }

    handleLoadSuccess(data, append) {
        const renderStart = performance.now();

        if (append) {
            this.categories = [...this.categories, ...data.categories];
        } else {
            this.categories = data.categories;
        }

        this.hasMore = data.hasMore;
        this.currentPage = data.currentPage;
        this.totalCount = data.totalCount;

        this.renderCategories();
        this.updateCategoryCount();

        // Update performance stats
        this.performanceStats.renderTime = Math.round(performance.now() - renderStart);
        this.updatePerformanceIndicator();
    }

    renderCategories() {
        if (this.categories.length === 0) {
            this.showEmptyState();
            return;
        }

        let html = '<div class="categories-menu p-2">';

        // Root category option
        html += this.renderRootOption();
        html += '<hr style="margin: 10px 0; border-color: #dee2e6;">';

        // Available categories
        for (const category of this.categories) {
            html += this.renderCategoryItem(category);
        }

        // Load more button
        if (this.hasMore) {
            html += this.renderLoadMoreButton();
        }

        html += '</div>';

        $('#categoryTree').html(html);
        this.attachEventListeners();
        this.highlightSelected();
    }

    renderRootOption() {
        const isSelected = !this.selectedParentId;
        return `
            <div class="category-item mb-3" data-category-level="root">
                <div class="root-category-option ${isSelected ? 'active' : ''}"
                     data-category-id=""
                     data-category-name="Danh mục gốc">
                    <div class="category-content">
                        <div class="d-flex align-items-center">
                            <div class="category-icon text-info mr-2">
                                <i class="fas fa-home"></i>
                            </div>
                            <div class="category-name">
                                <strong>🏠 Danh mục gốc</strong>
                                <small class="d-block text-muted">Không có danh mục cha</small>
                            </div>
                        </div>
                        <div class="category-meta">
                            <span class="badge badge-info">Gốc</span>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    renderCategoryItem(category) {
        const isSelected = this.selectedParentId == category.Id;
        const highlightedName = this.highlightText(category.Name, this.searchTerm);

        return `
            <div class="category-item" data-category-id="${category.Id}">
                <div class="category-link ${isSelected ? 'active' : ''}"
                     data-category-id="${category.Id}"
                     data-category-name="${this.escapeHtml(category.Name)}">
                    <div class="category-content">
                        <div class="d-flex align-items-center flex-grow-1">
                            <div class="category-icon mr-2">
                                <i class="fas fa-folder"></i>
                            </div>
                            <div class="category-info">
                                <div class="category-name">${highlightedName}</div>
                                ${category.Path ? `<small class="category-path text-muted">${this.escapeHtml(category.Path)}</small>` : ''}
                            </div>
                        </div>
                        <div class="category-meta">
                            <span class="news-count">${category.NewsCount || 0}</span>
                            ${category.HasChildren ? '<i class="fas fa-sitemap text-warning ml-1" title="Có danh mục con"></i>' : ''}
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    renderLoadMoreButton() {
        return `
            <div class="text-center py-3">
                <button type="button" class="btn btn-outline-primary btn-sm" id="loadMoreBtn">
                    <i class="fas fa-chevron-down mr-1"></i>
                    Tải thêm (${this.categories.length}/${this.totalCount})
                </button>
            </div>
        `;
    }

    attachEventListeners() {
        // Category selection
        $('#categoryTree').off('click', '.category-link, .root-category-option')
            .on('click', '.category-link, .root-category-option', (e) => {
                const categoryId = $(e.currentTarget).attr('data-category-id');
                const categoryName = $(e.currentTarget).attr('data-category-name');
                this.selectCategory(categoryId, categoryName);
            });

        // Load more
        $('#categoryTree').off('click', '#loadMoreBtn')
            .on('click', '#loadMoreBtn', () => {
                this.loadMore();
            });
    }

    async selectCategory(categoryId, categoryName) {
        // Validate selection
        const isValid = await this.validateCategorySelection(categoryId);
        if (!isValid) return;

        this.selectedParentId = categoryId || null;
        $('#selectedParentId').val(this.selectedParentId || '');

        // Update display
        this.updateSelectedDisplay(categoryName);

        // Update visual selection
        $('.category-link, .root-category-option').removeClass('active');
        if (categoryId) {
            $(`.category-link[data-category-id="${categoryId}"]`).addClass('active');
        } else {
            $('.root-category-option').addClass('active');
        }

        console.log('✅ Category selected:', categoryId, categoryName);
    }

    async validateCategorySelection(categoryId) {
        if (!categoryId) return true; // Root is always valid

        try {
            const response = await fetch(`${this.validateUrl}?editingCategoryId=${this.editingCategoryId}&parentId=${categoryId}`);
            const data = await response.json();

            if (data.success && !data.valid) {
                alert(data.message);
                return false;
            }

            return true;
        } catch (error) {
            console.error('Validation error:', error);
            return true; // Assume valid if validation fails
        }
    }

    validateSelection() {
        // Client-side validation before form submit
        if (this.selectedParentId && parseInt(this.selectedParentId) === this.editingCategoryId) {
            alert('Không thể chọn chính danh mục này làm danh mục cha!');
            return false;
        }
        return true;
    }

    updateSelectedDisplay(categoryName) {
        if (this.selectedParentId) {
            $('#selectedCategoryName').html(`
                <i class="fas fa-folder mr-1"></i>${this.escapeHtml(categoryName)}
            `);
            $('#clearSelection').show();
        } else {
            $('#selectedCategoryName').html(`
                <i class="fas fa-home mr-1"></i>Danh mục gốc (không có danh mục cha)
            `);
            $('#clearSelection').hide();
        }
    }

    clearSelection() {
        this.selectedParentId = null;
        $('#selectedParentId').val('');
        $('.category-link, .root-category-option').removeClass('active');
        $('.root-category-option').addClass('active');
        this.updateSelectedDisplay('Danh mục gốc');
    }

    async loadMore() {
        if (!this.hasMore || this.isLoading) return;

        this.currentPage++;
        await this.loadCategories(true);
    }

    handleScroll() {
        const container = $('#categoryTree')[0];
        if (!container) return;

        const scrollPercentage = (container.scrollTop + container.clientHeight) / container.scrollHeight;

        if (scrollPercentage > 0.8 && this.hasMore && !this.isLoading) {
            this.loadMore();
        }
    }

    showLoading(append = false) {
        if (append) {
            $('#loadMoreBtn').html('<i class="fas fa-spinner fa-spin mr-1"></i>Đang tải...');
        } else {
            $('#categoryTree').html(`
                <div class="loading-spinner text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="mt-2 mb-0">Đang tải danh mục khả dụng...</p>
                </div>
            `);
        }
    }

    showEmptyState() {
        const message = this.searchTerm
            ? `Không tìm thấy danh mục cho "${this.searchTerm}"`
            : 'Không có danh mục cha khả dụng';

        $('#categoryTree').html(`
            <div class="text-center py-4">
                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                <p class="text-muted">${message}</p>
                <small>Danh mục này sẽ trở thành danh mục gốc</small>
            </div>
        `);
    }

    showError(message) {
        $('#categoryTree').html(`
            <div class="text-center py-4">
                <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                <p class="text-danger">${message}</p>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="editCategorySelector.resetAndLoad()">
                    <i class="fas fa-redo mr-1"></i>Thử lại
                </button>
            </div>
        `);
    }

    updateCategoryCount() {
        $('#categoryCount').text(`${this.totalCount} danh mục khả dụng`);
    }

    updatePerformanceIndicator() {
        const stats = this.performanceStats;
        $('#performanceIndicator').text(
            `Load: ${stats.loadTime}ms | Render: ${stats.renderTime}ms | Items: ${this.categories.length}`
        );
    }

    highlightSelected() {
        if (this.selectedParentId) {
            $(`.category-link[data-category-id="${this.selectedParentId}"]`).addClass('active');
        } else {
            $('.root-category-option').addClass('active');
        }
    }

    highlightText(text, searchTerm) {
        if (!searchTerm || !text) return this.escapeHtml(text);

        const escapedText = this.escapeHtml(text);
        const escapedTerm = this.escapeHtml(searchTerm);
        const regex = new RegExp(`(${escapedTerm})`, 'gi');

        return escapedText.replace(regex, '<span class="search-highlight">$1</span>');
    }

    escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Public methods for debugging
    getStats() {
        return {
            categories: this.categories.length,
            totalCount: this.totalCount,
            currentPage: this.currentPage,
            hasMore: this.hasMore,
            cacheSize: this.cache.size,
            performance: this.performanceStats,
            selectedParentId: this.selectedParentId
        };
    }
}

// =================== INITIALIZATION ===================

let editCategorySelector;

$(document).ready(function() {
    const editingCategoryId = @Model.Id;
    const selectedParentId = @Html.Raw(Model.ParentId?.ToString() ?? "null");

    editCategorySelector = new OptimizedEditCategorySelector(editingCategoryId, selectedParentId);

    console.log('🚀 Optimized Edit Category Selector initialized!');
    console.log('📊 Editing Category ID:', editingCategoryId);
    console.log('📂 Initial Parent ID:', selectedParentId);
});

// =================== DEBUG FUNCTIONS ===================

function debugSelection() {
    const stats = editCategorySelector.getStats();
    const selected = editCategorySelector.selectedParentId;

    console.log('Debug Info:', stats);

    alert(`
🔍 Debug Information:
• Editing Category ID: ${editCategorySelector.editingCategoryId}
• Selected Parent ID: ${selected || 'None (Root)'}
• Available Categories: ${stats.categories}/${stats.totalCount}
• Current Page: ${stats.currentPage}
• Has More: ${stats.hasMore}
• Cache Size: ${stats.cacheSize}

⚡ Performance:
• Load Time: ${stats.performance.loadTime}ms
• Render Time: ${stats.performance.renderTime}ms

✅ Status: Ready for 1M+ categories!
    `);
}

function testPerformance() {
    console.time('Performance Test');

    // Test multiple renders
    const iterations = 10;
    const startTime = performance.now();

    for (let i = 0; i < iterations; i++) {
        editCategorySelector.renderCategories();
    }

    const endTime = performance.now();
    const avgTime = (endTime - startTime) / iterations;

    console.timeEnd('Performance Test');
    alert(`Performance Test Results:
• ${iterations} render operations
• Average: ${avgTime.toFixed(2)}ms per render
• Status: ${avgTime < 16 ? '✅ Excellent (60+ FPS)' : '⚠️ Good enough'}`);
}

function loadTestData() {
    // Simulate loading many categories
    const testCategories = [];
    for (let i = 0; i < 100; i++) {
        testCategories.push({
            Id: i + 1000,
            Name: `Test Category ${i + 1}`,
            Path: `Root > Level 1 > Test Category ${i + 1}`,
            NewsCount: Math.floor(Math.random() * 50),
            HasChildren: Math.random() > 0.7
        });
    }

    editCategorySelector.categories = testCategories;
    editCategorySelector.totalCount = 100;
    editCategorySelector.hasMore = false;
    editCategorySelector.renderCategories();
    editCategorySelector.updateCategoryCount();

    alert('✅ Loaded 100 test categories for performance testing!');
}
</script>